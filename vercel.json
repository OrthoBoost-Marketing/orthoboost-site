{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    { "source": "/assets/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] }
  ],
  "redirects": [
    { "source": "/services/google-ads-for-orthodontists", "destination": "/google-ads-for-orthodontists", "permanent": true },
    { "source": "/services/social-media-ads-for-orthodontists", "destination": "/social-media-marketing-for-orthodontists", "permanent": true },
    { "source": "/services/seo-for-orthodontists", "destination": "/seo-for-orthodontists", "permanent": true },
    { "source": "/services/follow-up-for-orthodontists", "destination": "/services", "permanent": true },
    { "source": "/guides/ultimate-follow-up-guide-for-orthodontists", "destination": "/guides", "permanent": true },
    { "source": "/guides/ultimate-treatment-coordinator-guide-for-orthodontists", "destination": "/guides", "permanent": true },
    { "source": "/how-it-works", "destination": "/", "permanent": true }
  ]
}
